# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://postgres@localhost:5433/offroad_dev
# Long random string (e.g. `openssl rand -base64 48`). Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Optional, comma-separated list of allowed origins (e.g. http://localhost:8081). Empty = same-origin only.
CORS_ORIGIN=
# Optional: path to the Expo web build (defaults to ../app/dist)
# WEB_DIST=
NODE_ENV=development
# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_LOGIN=10          # per IP+email per 15 min
# RATE_LIMIT_LOGIN_PER_IP=100  # per IP per 15 min
# RATE_LIMIT_REGISTER=20       # per IP per 15 min
# RATE_LIMIT_REFRESH=60        # per IP per 15 min
# RATE_LIMIT_CREATE=30         # per user per hour (spots, cars, mods each)
