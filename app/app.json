{
  "expo": {
    "name": "Offroad",
    "slug": "offroad-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a photo for your profile or your car."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Offroad",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile or your car.",
          "cameraPermission": false
        }
      ]
    ],
    "scheme": "offroad",
    "backgroundColor": "#F2F2F7",
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "bahmansway",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99c3d8a0-93a8-4404-8e6c-8cebf38958a2"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/99c3d8a0-93a8-4404-8e6c-8cebf38958a2"
    }
  }
}
