# Copy to app/.env (git-ignored). No secrets belong here — EXPO_PUBLIC_* values are built into the app.

# Where the API lives.
# - Dev, empty: web uses http://localhost:4000; Expo Go on a phone uses your computer's LAN IP, port 4000.
# - Web production build served by the API, empty: same origin.
# - PHONE STORE BUILDS (EAS): MUST be set to the https Railway URL, e.g. https://offroad.up.railway.app
#   Without it the phone app points at localhost and cannot reach the server.
EXPO_PUBLIC_API_URL=

# Web dev note: the Expo web dev server runs on http://localhost:8081, a different origin than the API,
# so the server must allow it. Put this in server/.env (not here):
#   CORS_ORIGIN=http://localhost:8081
